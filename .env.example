# Full player / API server configuration (VPS Docker and Node runtimes)
PORT=3000
PLAYER_PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public domain and origin used for browser-safe HLS URLs. deploy/vps.sh fills
# these from its domain argument and generates missing secrets automatically.
DOMAIN=
PUBLIC_BASE_URL=

# Node-only progressive MKV/MP4 to HLS conversion. Keep this disabled on
# Cloudflare Workers, which cannot spawn ffmpeg.
MKV_HLS_ENABLED=true
MKV_HLS_NODE_HOST=true
MKV_HLS_DIR=/data/hls
MKV_HLS_MAX_SESSIONS=2

# Goldmine server — the owner-hosted TMDB-Embed-API instance
# (https://github.com/themithology/TMDB-Embed-API). It aggregates a dozen
# stream providers behind one JSON API and answers with direct MKV/MP4 files
# (multi-audio dubs) plus HLS sources. Progressive files are converted to HLS
# by the Node host before they reach the browser.
GOLDMINE_API_BASE=https://rdp-running-campion.onrender.com
# Free-tier hosts cold-start slowly; the aggregate endpoint fans out to every
# enabled provider, so keep this generous.
GOLDMINE_TIMEOUT_MS=30000
# Wrap direct file URLs in this backend's signed /api/proxy (CORS + Range +
# server-side Referer/User-Agent — some providers gate on headers a browser
# cannot send). Set to false only if the upstream instance has enableProxy on.
GOLDMINE_PROXY_STREAMS=true

# TMDB API Key (A working default v3 key is built-in; optionally set your own from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# Subtitles: OpenSubtitles (via Stremio's v3 addon) needs no key. Optional
# extra sources with free keys: Wyzie (https://store.wyzie.io/redeem) and
# SubDL (https://subdl.com account panel).
WYZIE_API_KEY=
SUBDL_API_KEY=
# Extra hosts the subtitle proxy may fetch from (comma-separated; * = any).
SUBTITLE_PROXY_HOSTS=

# Skip Intro / Recap / Credits providers (all work without keys).
# TheIntroDB is keyed by TMDB id; an optional key only raises its daily quota.
THEINTRODB_URL=https://api.theintrodb.org/v3
THEINTRODB_API_KEY=
INTRODB_URL=https://api.introdb.app
ANISKIP_URL=https://api.aniskip.com/v2

# Edge Proxy Pool (Optional: comma-separated Cloudflare Worker URLs to offload stream bandwidth)
# Example: EXTERNAL_PROXY_POOL=https://proxy-1.yourname.workers.dev,https://proxy-2.yourname.workers.dev
EXTERNAL_PROXY_POOL=

# Security & Signing
ADMIN_SECRET=change-this-to-a-random-admin-key
PROXY_SECRET=change-this-to-a-random-hmac-secret-key
TOKEN_TTL_SECONDS=14400

# Optional Upstash Redis REST Cache (Not needed on a VPS since in-memory cache persists 24/7)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
