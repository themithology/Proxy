# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# LOL Embed API base URL (Optional: e.g. https://api.lol-embed.example)
PUBLIC_BASE_URL=

# Upstream Server Andromeda Multi-Tier Configuration & Dynamic Discovery
CASTLETV_BASE_URL=https://api.hlowb.com
NETMIRROR_BASE_URL=https://net27.cc
NETMIRROR_WEB_MIRRORS=https://net27.cc,https://net52.cc,https://net77.cc,https://netmiror.com
NETMIRROR_DISCOVERY_URLS=https://mobiledetect.app,https://mobiledetects.com,https://mobidetect.cc,https://mobidetects.top,https://getimgcdn.com,https://mobidetect.art,https://mobidetect.click

# TMDB API Key (A working default v3 key is built-in; optionally set your own from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=47a1a7df542d3d483227f758a7317dff
TMDB_BEARER_TOKEN=

# Subtitles: OpenSubtitles (via Stremio's v3 addon) needs no key. Optional
# extra sources with free keys: Wyzie (https://store.wyzie.io/redeem) and
# SubDL (https://subdl.com account panel).
WYZIE_API_KEY=
SUBDL_API_KEY=
# Extra hosts the subtitle proxy may fetch from (comma-separated; * = any).
SUBTITLE_PROXY_HOSTS=

# Skip Intro / Recap / Credits providers (all work without keys).
# TheIntroDB is keyed by TMDB id; an optional key only raises its daily quota.
THEINTRODB_URL=https://api.theintrodb.org/v3
THEINTRODB_API_KEY=
INTRODB_URL=https://api.introdb.app
ANISKIP_URL=https://api.aniskip.com/v2

# Edge Proxy Pool (Optional: comma-separated Cloudflare Worker URLs to offload M3U8/TS bandwidth)
# Example: EXTERNAL_PROXY_POOL=https://proxy-1.yourname.workers.dev,https://proxy-2.yourname.workers.dev
EXTERNAL_PROXY_POOL=

# ---------------------------------------------------------------------------
# Security & Signing — REQUIRED in production
# ---------------------------------------------------------------------------
# Both secrets are mandatory when NODE_ENV=production: the server refuses to
# boot without them, because the previous defaults were committed to this repo.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PROXY_SECRET must be IDENTICAL on every runtime that signs or verifies proxy
# URLs (Node backend, the Cloudflare Worker, and any EXTERNAL_PROXY_POOL node).
# ADMIN_SECRET also guards /reze. Send it as `X-Admin-Key` — `?key=` in a query
# string is no longer accepted (it leaks into logs, Referer headers and history).
ADMIN_SECRET=
PROXY_SECRET=
TOKEN_TTL_SECONDS=14400
# Lifetime of a signed /api/proxy URL (seconds). Default 4h.
PROXY_URL_TTL_SECONDS=14400

# How many reverse-proxy hops to trust for X-Forwarded-For. Default 1.
# `true`/unbounded used to let any caller forge its source IP and reset per-IP
# rate limits. Use 2 for CF -> nginx -> node.
TRUST_PROXY_HOPS=1

# Per-client rate limits (requests per minute). /api/resolve stays public — it is
# an embed API — but TMDB ids are sequential integers, so without a limit anyone
# can walk the entire catalog. Set RATE_LIMIT_ENABLED=false only for local tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RESOLVE_PER_MINUTE=30
RATE_LIMIT_PROXY_PER_MINUTE=600
RATE_LIMIT_METADATA_PER_MINUTE=120
RATE_LIMIT_HANDSHAKE_PER_MINUTE=30
RATE_LIMIT_ADMIN_AUTH_PER_MINUTE=10

# TEST/DEV ONLY. Lets the media proxy reach loopback and private ranges so the
# hermetic suite can proxy to a 127.0.0.1 mock upstream. Ignored entirely when
# NODE_ENV=production — the SSRF guard cannot be switched off in production.
PROXY_ALLOW_PRIVATE_TARGETS=false

# Node-only embedded MKV/MP4 multi-audio remuxing (requires both binaries; paths may override PATH lookup)
MULTITRACK_ENABLED=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MULTITRACK_CACHE_DIR=
MULTITRACK_CACHE_TTL_MS=7200000
MULTITRACK_PROBE_TIMEOUT_MS=8000
MULTITRACK_STARTUP_TIMEOUT_MS=30000
MULTITRACK_JOB_TIMEOUT_MS=1200000
MULTITRACK_MAX_JOBS=1
# Optional comma-separated trusted CDN suffixes; built-in allowlist remains enabled
MULTITRACK_ALLOWED_HOSTS=

# Optional Upstash Redis REST Cache (Not needed on a VPS since in-memory cache persists 24/7)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
