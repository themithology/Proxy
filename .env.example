# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# LOL Embed API base URL (Optional: e.g. https://api.lol-embed.example)
PUBLIC_BASE_URL=

# Upstream Server Andromeda Multi-Tier Configuration & Dynamic Discovery
CASTLETV_BASE_URL=https://api.hlowb.com
NETMIRROR_BASE_URL=https://net27.cc
NETMIRROR_WEB_MIRRORS=https://net27.cc,https://net52.cc,https://net77.cc,https://netmiror.com
NETMIRROR_DISCOVERY_URLS=https://mobiledetect.app,https://mobiledetects.com,https://mobidetect.cc,https://mobidetects.top,https://getimgcdn.com,https://mobidetect.art,https://mobidetect.click

# ── Hamster Wheel (server #3): Hindi-first fan-out ─────────────────────────
# Providers: MovieBox (HMAC mobile API), HindMoviez and 4KHDHub. Domains rotate,
# so site bases are read from a public domains.json (cached 30 min) and the env
# values below are only fallbacks. Node backend only — on the Worker, point
# HAMSTER_BACKEND_URL at this Node deployment.
HAMSTER_ENABLED=true
HAMSTER_TIMEOUT_MS=12000
HAMSTER_PROVIDER_TIMEOUT_MS=9000
HAMSTER_PROBE_TIMEOUT_MS=3500
HAMSTER_UNROLL_BUDGET_MS=7000
HAMSTER_MAX_CANDIDATES=10
HAMSTER_MAX_PROBE_CANDIDATES=5
HAMSTER_DOMAINS_URL=https://raw.githubusercontent.com/phisher98/TVVVV/main/domains.json
HAMSTER_DOMAINS_TTL_MS=1800000
HINDMOVIEZ_BASE_URL=https://hindmovie.dev
FOURKHDHUB_BASE_URL=https://4khdhub.one
MOVIEBOX_HOSTS=https://api6.aoneroom.com,https://api5.aoneroom.com,https://api4.aoneroom.com,https://api4sg.aoneroom.com,https://api3.aoneroom.com,https://api6sg.aoneroom.com,https://api.inmoviebox.com
MOVIEBOX_REGION=IN
# Only needed if MovieBox rotates its client key: 60-hex-char HMAC secret
MOVIEBOX_SECRET_HEX=

# ── Centaurus (server #2) source #2: Anime Dub Hindi ───────────────────────
# Hindi-dub anime release blog (WordPress → adhlinks → HubCloud/GDFlix). Post
# and episode slugs are followed from the site, never constructed; only the blog
# base is configurable. Applies to the Node backend and the Worker (which shares
# src/ via nodejs_compat).
ANIMEDUBHINDI_ENABLED=true
ANIMEDUBHINDI_BASE_URL=https://www.animedubhindi.link
ANIMEDUBHINDI_TIMEOUT_MS=8000
ANIMEDUBHINDI_UNROLL_BUDGET_MS=6000
ANIMEDUBHINDI_PROBE_TIMEOUT_MS=3500
ANIMEDUBHINDI_MAX_PROBE_CANDIDATES=5
ANIMEDUBHINDI_PAGE_BODY_CAP=1433600

# ── Centaurus (server #2) source #3: AnimeDrive ────────────────────────────
# Second Hindi-dub anime release blog (search → post → link.animedrive.cc
# landing page). Row links are wrapped as base64url(reverse(url)) and decode to
# HubCloud/GDFlix; paths are followed from the site, never constructed.
ANIMEDRIVE_ENABLED=true
ANIMEDRIVE_BASE_URL=https://animedrive.cc
ANIMEDRIVE_LINKS_BASE_URL=https://link.animedrive.cc
ANIMEDRIVE_TIMEOUT_MS=8000
ANIMEDRIVE_UNROLL_BUDGET_MS=6000
ANIMEDRIVE_PROBE_TIMEOUT_MS=3500
ANIMEDRIVE_MAX_PROBE_CANDIDATES=6
ANIMEDRIVE_PAGE_BODY_CAP=1638400

# TMDB API Key (A working default v3 key is built-in; optionally set your own from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=47a1a7df542d3d483227f758a7317dff
TMDB_BEARER_TOKEN=

# Wyzie Subtitles API Key (Optional: free key at https://store.wyzie.io/redeem; OpenSubtitles works without a key)
WYZIE_API_KEY=

# Edge Proxy Pool (Optional: comma-separated Cloudflare Worker URLs to offload M3U8/TS bandwidth)
# Example: EXTERNAL_PROXY_POOL=https://proxy-1.yourname.workers.dev,https://proxy-2.yourname.workers.dev
EXTERNAL_PROXY_POOL=

# Security & Signing
PROXY_SECRET=change-this-to-a-random-hmac-secret-key
TOKEN_TTL_SECONDS=14400

# Node-only embedded MKV/MP4 multi-audio remuxing (requires both binaries; paths may override PATH lookup)
MULTITRACK_ENABLED=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MULTITRACK_CACHE_DIR=
MULTITRACK_CACHE_TTL_MS=7200000
MULTITRACK_PROBE_TIMEOUT_MS=8000
MULTITRACK_STARTUP_TIMEOUT_MS=30000
MULTITRACK_JOB_TIMEOUT_MS=1200000
MULTITRACK_MAX_JOBS=1
# Optional comma-separated trusted CDN suffixes; built-in allowlist remains enabled
MULTITRACK_ALLOWED_HOSTS=

# Optional Upstash Redis REST Cache (Not needed on a VPS since in-memory cache persists 24/7)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
